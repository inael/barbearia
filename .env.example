# .env.example — variáveis que este projeto consome.
# Valores reais vivem em ~/.claude/credentials/services.env e nos secrets do CI/CD.
# Nunca commitar .env real.

# === Aplicação ===
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# === Supabase (banco + storage) ===
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://...

# === Auth (Logto) ===
# LOGTO_ENDPOINT=
# LOGTO_APP_ID=
# LOGTO_APP_SECRET=

# === Pagamentos (Asaas) ===
# ASAAS_API_BASE=https://api.asaas.com/v3
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_USER_AGENT=barbearia-itbooster   # obrigatório em produção

# === WhatsApp (SimplesZap) ===
# SIMPLESZAP_API_BASE=
# SIMPLESZAP_API_KEY=sk_...
# SIMPLESZAP_INSTANCE_ID=

# === Hub de IA (LiteLLM) ===
# LITELLM_URL=http://litellm:4000
# LITELLM_KEY=
