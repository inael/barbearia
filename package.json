{
  "name": "barbearia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "next build && playwright test",
    "test:critical": "next build && playwright test --grep @critical",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "quality:quick": "npm run lint && npm run typecheck && npm run test:unit",
    "quality:feature": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e",
    "quality:full": "node tools/gate.mjs full",
    "gate": "node tools/gate.mjs",
    "tlc": "node tools/tlc-validate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx lib/db/seed.run.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "next": "16.3.0",
    "postgres": "^3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.9.0",
    "tailwindcss": "^4",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
